{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build YouTube Music Player",
      "type": "shell",
      "command": "javac",
      "args": ["-encoding", "UTF-8", "-d", "target/classes", "src/main/java/YouTubeMusicPlayer.java"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": "$javac",
      "group": {"kind": "build", "isDefault": true}
    }
  ]
}
